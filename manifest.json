{
  "name": "pet",
  "version": "2.0.1",
  "displayName": "宠物",
  "author": "chenzhi",
  "description": "桌面宠物：右下角无边框透明窗体，喂食/洗澡涨成长与好感，点击摸头每小时加好感",
  "apiVersion": 2,
  "main": "./index.js",
  "contributes": {
    "statusBarItems": [
      { "id": "pet.status", "name": "宠物", "text": "宠物", "alignment": "right", "priority": 10 }
    ],
    "settings": {
      "id": "pet.settings",
      "title": "宠物",
      "fields": [
        { "key": "pet.visible", "label": "显示宠物", "type": "boolean", "default": true },
        { "key": "pet.growth", "label": "成长值", "type": "status", "default": "0" },
        { "key": "pet.favor", "label": "好感", "type": "progress", "max": 650, "default": 0 },
        { "key": "pet.favorExact", "label": "好感（精确值）", "type": "status", "default": "0" },
        { "key": "pet.level", "label": "等级", "type": "status", "default": "初次见面" },
        { "key": "pet.diagnostic", "label": "诊断", "type": "status", "default": "" }
      ]
    }
  }
}
